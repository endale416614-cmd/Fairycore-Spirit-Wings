  <GeneDef>
    <defName>FG_Venenum</defName>
    <label>Venenum</label>
    <description>What are you doing at the end of the world? Are you busy? Will you save us?\n\nVenenum is a dormant psychic power that awakens into radiant wings, granting power meant to carry its bearer through impossible odds for those they hold dear.\n\n&lt;color=#E6E64C&gt;Effects:&lt;/color&gt;\n - Flight\n - Increased evasion\n - Increased psychic sensitivity\n - Fire immunity\n - Ageless\n\n&lt;color=#E6E64C&gt;Gives abilities:&lt;/color&gt;\n - Flutter Dash\n - Momentum\n - Indomitable\n - Brandish\n - Avalanche</description>
    <iconPath>FairyGenes/UI/Gene_Venenum</iconPath>
    <geneClass>FairyGenes.Gene_Venenum</geneClass>
    <displayCategory>FG_Wings</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <descriptionHyperlinks>
      <AbilityDef>FG_FairyFlutter</AbilityDef>
      <AbilityDef>FG_FairysGate</AbilityDef>
      <HediffDef>FG_VenenumActive</HediffDef>
      <HediffDef>FG_Momentum</HediffDef>
      <HediffDef>FG_PsychicDelirium</HediffDef>
    </descriptionHyperlinks>
    <biostatCpx>10</biostatCpx>
    <biostatMet>20</biostatMet>
    <exclusionTags>
      <li>FG_Venenum</li>
    </exclusionTags>
    <symbolPack>
      <wholeNameSymbols>
        <li><symbol>fairy</symbol></li>
        <li><symbol>pixie</symbol></li>
        <li><symbol>venom</symbol></li>
      </wholeNameSymbols>
      <prefixSymbols>
        <li><symbol>flutter</symbol></li>
        <li><symbol>fae</symbol></li>
        <li><symbol>venom</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>wing</symbol></li>
        <li><symbol>fae</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

  <!-- Lesser Venenum: wings and flight, for anyone, plus about 50% evasion in flight (Gene_LesserVenenum). -->
