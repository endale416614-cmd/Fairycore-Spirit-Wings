  <HediffDef>
    <defName>FG_PsychicDelirium</defName>
    <label>psychic delirium</label>
    <description>Forcing Venenum past its neural heat limit opens the carrier's mind to something unknown.

They begin seeing a red-haired girl, hearing her incomprehensible words inside their thoughts. Each use makes the visions clearer and reality harder to trust.</description>
    <hediffClass>FairyGenes.Hediff_PsychicDelirium</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>0.05</initialSeverity>
    <minSeverity>0</minSeverity>
    <maxSeverity>1</maxSeverity>
    <everCurableByItem>false</everCurableByItem>
    <defaultLabelColor>(0.85,0.45,0.95)</defaultLabelColor>
    <stages>
      <!-- Delirium carries its own consciousness: a growing bonus that counters neural heat's psychic
           breakdown (-25% minor, -50% major), fully at the frenzy. A psychic shock (lance) still caps it: setMax wins. -->
      <li>
        <label>faint</label>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.05</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.2</minSeverity>
        <label>unsettling</label>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.15</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>fractured</label>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.25</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>severe</label>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.35</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.9</minSeverity>
        <label>frenzied</label>
        <lifeThreatening>true</lifeThreatening>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>0.5</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <MentalStateDef ParentName="WanderPsychotic">
    <defName>FG_DeliriumConfusion</defName>
