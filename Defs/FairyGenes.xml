  <HediffDef>
    <defName>FG_VenenumActive</defName>
    <label>Venenum</label>
    <description>A soul manifested as glowing wings of psychic energy, shielding its bearer from fire and granting them the power to protect their loved ones, at a price.</description>
    <hediffClass>FairyGenes.Hediff_VenenumActive</hediffClass>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <everCurableByItem>false</everCurableByItem>
    <defaultLabelColor>(0.75,0.6,1)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_DisappearsOnDeath"/>
    </comps>
    <stages>
      <li>
        <statOffsets>
