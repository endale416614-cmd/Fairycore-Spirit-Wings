        <drawSize>(0.7,1.4)</drawSize>
        <parentTagDef>Body</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <baseLayer>-11</baseLayer>
        <drawData>
          <dataNorth><layer>47</layer></dataNorth>
        </drawData>
