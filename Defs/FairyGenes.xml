    <biostatCpx>5</biostatCpx>
    <biostatMet>0</biostatMet>
    <exclusionTags>
      <li>FG_Venenum</li>
    </exclusionTags>
  </GeneDef>

  <!-- The 20 wing genes (FG_Wings_<key>, generated into FairyWings_Generated.xml): 0 complexity, one
       chosen at random when a xenotype lists several. On their own they are a pair of wings on the back, always shown,
       flapping gently, no flight. With Venenum they are its wings: shown only while it is on (Source/FairyRender.cs).
       Venenum needs one in the xenotype editor (Patch_GeneCreationDialog_CanAccept_VenenumWings). -->
  <GeneDef Name="FG_WingDesignBase" Abstract="True">
    <displayCategory>FG_Wings</displayCategory>
    <biostatCpx>0</biostatCpx>
    <biostatMet>0</biostatMet>
    <randomChosen>true</randomChosen>
    <exclusionTags>
      <li>Wings</li>
    </exclusionTags>
    <statOffsets>
      <PawnBeauty>2</PawnBeauty>
    </statOffsets>
    <renderNodeProperties>
      <li Class="FairyGenes.PawnRenderNodeProperties_FairyWing">
        <debugLabel>wing glow L</debugLabel>
        <nodeClass>FairyGenes.PawnRenderNode_FairyWing</nodeClass>
        <workerClass>FairyGenes.PawnRenderNodeWorker_FairyWing</workerClass>
        <half>ScreenLeft</half>
        <glow>true</glow>
        <tagDef>FG_GlowLeft</tagDef>
        <texPath>FairyGenes/Glow/Monarch/Rest_L</texPath>
        <shaderTypeDef>MoteGlow</shaderTypeDef>
        <drawSize>(0.7,1.4)</drawSize>
        <parentTagDef>Body</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <baseLayer>-11</baseLayer>
        <drawData>
          <dataNorth><layer>47</layer></dataNorth>
        </drawData>
      </li>
      <li Class="FairyGenes.PawnRenderNodeProperties_FairyWing">
        <debugLabel>wing glow R</debugLabel>
        <nodeClass>FairyGenes.PawnRenderNode_FairyWing</nodeClass>
        <workerClass>FairyGenes.PawnRenderNodeWorker_FairyWing</workerClass>
